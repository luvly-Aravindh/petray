# All optional: lib/desk.ts has working defaults. Uncomment only to use a different
# Desk endpoint or key (here in .env.local, or in the hosting platform's env settings).

# DESK_URL=https://deskbackend.getnos.io/v1/lead
# DESK_API_KEY=lh_live_YOUR_KEY
# Key for the browser fallback (used only if /api/lead is unavailable)
# NEXT_PUBLIC_DESK_API_KEY=lh_live_YOUR_KEY
